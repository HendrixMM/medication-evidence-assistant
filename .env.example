# Required for OpenAI-backed agent and retrieval paths.
OPENAI_API_KEY=

# Optional provider/API keys.
NVIDIA_API_KEY=
PERPLEXITY_API_KEY=
PUBMED_EMAIL=
PUBMED_API_KEY=
PUBMED_EUTILS_API_KEY=

# Agent/runtime settings.
AGENT_LLM_PROVIDER=openai
AGENT_MODEL=gpt-5.4-mini
LLM_MODEL=gpt-5.4-mini
AGENT_MAX_TURNS=4
EVIDENCE_QUERY_BUDGET_MAX=12
EVIDENCE_MAX_LLM_SCORING_CANDIDATES=15
EVIDENCE_CACHE_TTL_SECONDS=86400
AGENT_MODE_ENABLED=true

# Safety and API behavior.
AGENT_ENABLE_GUARDRAILS=false
ENABLE_MEDICAL_GUARDRAILS=false
CORS_ALLOW_ORIGINS=http://localhost:3000
API_CHAT_MAX_REQUESTS_PER_MINUTE=10
API_CHAT_MAX_REQUESTS_PER_DAY=
TRUST_FORWARDED_HEADERS=true
